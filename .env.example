# RouterOne — Variáveis de Ambiente

# === PROXY ===
PROXY_PORT=3000
PROXY_HOST=0.0.0.0

# === DATABASE ===
DATABASE_URL=postgresql://routerone:routerone@postgres:5432/routerone

# === REDIS ===
REDIS_URL=redis://redis:6379

# === PROVIDER API KEYS (nunca commites isto) ===
OPENAI_API_KEY=sk-openai-xxx
ANTHROPIC_API_KEY=sk-ant-xxx
GROQ_API_KEY=gsk-xxx
DEEPSEEK_API_KEY=sk-ds-xxx

# === LITELLM SERVICE ===
LITELLM_URL=http://litellm:4000
LITELLM_MASTER_KEY=sk-litellm-master-xxx

# === DASHBOARD ===
NEXT_PUBLIC_API_URL=http://localhost:3000
DASHBOARD_PORT=3001

# === EVALUATION ===
EVALUATION_PORT=3002

# === AUTH ===
JWT_SECRET=change-me-in-production-min-32-chars-long

# === OTEL ===
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=routerone-proxy
